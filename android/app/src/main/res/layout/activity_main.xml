<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Video Surface -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating pills (Visible when HUD is hidden) -->
    <LinearLayout
        android:id="@+id/layout_floating_pills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_floating_drag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/card_bg"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="✋ Seçim / Sürükle"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_floating_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/card_bg"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="📱 Touch"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_show_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="⚙️ Menü"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Top-Center Drag / Selection Status Indicator Badge -->
    <TextView
        android:id="@+id/tv_drag_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_bg"
        android:clickable="false"
        android:focusable="false"
        android:elevation="12dp"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="✋ Seçim Yapılıyor..."
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Overlay HUD Card -->
    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mac 2nd Screen"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rotate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/btn_outline"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🔄 Döndür"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_ready"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Mode Switch: 2nd Screen vs Touch Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_mode_screen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_cyan"
                android:text="🖥️ 2. Ekran"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode_touchbar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_outline"
                android:text="🪄 Touch Bar"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mouse / Touch Mode Selector Button (Visible in Screen Mode) -->
        <Button
            android:id="@+id/btn_toggle_mode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_outline"
            android:text="📱 Mod: Dokunmatik (Touch)"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/border_subtle" />

        <!-- USB Quick Connect Button -->
        <Button
            android:id="@+id/btn_usb"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/btn_cyan"
            android:text="@string/usb_connect"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Wi-Fi Auto Discover Button -->
        <Button
            android:id="@+id/btn_wifi_discover"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_outline"
            android:text="@string/wifi_auto"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <!-- Manual IP Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_manual_ip"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_bg"
                android:hint="192.168.1.x:8888"
                android:inputType="textUri"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_connect_manual"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_outline"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Connected action buttons -->
        <LinearLayout
            android:id="@+id/layout_connected_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_hide_hud"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_outline"
                android:text="Tam Ekran Yap"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_outline"
                android:text="@string/disconnect"
                android:textAllCaps="false"
                android:textColor="@color/accent_red"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Trackpad Buttons Bar (Visible in Mouse Mode when HUD is hidden) -->
    <LinearLayout
        android:id="@+id/layout_trackpad_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_bg"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_trackpad_left"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_outline"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🖱️ Sol Tık"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_trackpad_drag_lock"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_outline"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="✋ Seçim Kilidi"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_trackpad_right"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_outline"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🖱️ Sağ Tık"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>

