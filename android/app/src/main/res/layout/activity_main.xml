<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Main Dynamic Display Container (Single or Split Modes) -->
    <LinearLayout
        android:id="@+id/container_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Primary View Area (Top or Full Screen) -->
        <FrameLayout
            android:id="@+id/container_primary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <SurfaceView
                android:id="@+id/surface_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/include_touchpad_primary"
                layout="@layout/layout_touchpad"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Divider line (visible in split modes) -->
        <View
            android:id="@+id/view_split_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#2E3447"
            android:visibility="gone" />

        <!-- Secondary View Area (Bottom for Split Modes) -->
        <FrameLayout
            android:id="@+id/container_secondary"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:visibility="gone">

            <SurfaceView
                android:id="@+id/surface_view_secondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/include_touchpad_secondary"
                layout="@layout/layout_touchpad"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Top floating pills (Visible when HUD is hidden) -->
    <LinearLayout
        android:id="@+id/layout_floating_pills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_floating_drag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/card_bg"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="✋ Seçim / Sürükle"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_floating_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/card_bg"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="📱 Mod"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_show_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="⚙️ Menü"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Top-Center Drag / Selection Status Indicator Badge -->
    <TextView
        android:id="@+id/tv_drag_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_bg"
        android:clickable="false"
        android:focusable="false"
        android:elevation="12dp"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="✋ Seçim Yapılıyor..."
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Overlay HUD Card -->
    <ScrollView
        android:id="@+id/hud_scroll_wrapper"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hud_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Title & Rotate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mac Screen Studio"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_rotate"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_outline"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🔄 Döndür"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_ready"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Mode Selector Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Görünüm Modu:"
                android:textColor="#8892B0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mode Selector Rows (5 Modes) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mode_screen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/btn_cyan"
                    android:text="🖥️ Ekran"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_mode_touchbar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/btn_outline"
                    android:text="🪄 TouchBar"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_mode_touchpad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:text="🖱️ Touchpad"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Dual / Split Modes Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mode_split_screen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/btn_outline"
                    android:text="📱 Ekran + TouchBar"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_mode_split_touchpad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:text="📱 TouchBar + Pad"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Mouse / Touch Sub-mode (visible in Screen mode) -->
            <Button
                android:id="@+id/btn_toggle_mode"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="📱 Mod: Dokunmatik (Touch)"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/border_subtle" />

            <!-- USB Connect Button -->
            <Button
                android:id="@+id/btn_usb"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_cyan"
                android:text="@string/usb_connect"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Wi-Fi Auto Discover Button -->
            <Button
                android:id="@+id/btn_wifi_discover"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="@string/wifi_auto"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />

            <!-- Discovered Servers Container -->
            <LinearLayout
                android:id="@+id/layout_discovered_servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Manual IP Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_manual_ip"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_bg"
                    android:hint="192.168.1.x:8888"
                    android:inputType="textUri"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_connect_manual"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_outline"
                    android:text="@string/connect"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Connected Actions (Hide HUD / Disconnect) -->
            <LinearLayout
                android:id="@+id/layout_connected_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_hide_hud"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_outline"
                    android:text="👁️ Menüyü Gizle"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_disconnect"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_outline"
                    android:text="❌ Bağlantıyı Kes"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Trackpad Mouse Bottom Physical Buttons for Screen Trackpad Mode -->
    <LinearLayout
        android:id="@+id/layout_trackpad_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_bg"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_trackpad_left"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_outline"
            android:text="Sol Tık"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_trackpad_drag_lock"
            android:layout_width="88dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_outline"
            android:text="🔒 Seçim"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_trackpad_right"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_outline"
            android:text="Sağ Tık"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
